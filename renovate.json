{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":dependencyDashboard"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency update dashboard",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": [
    "after 6am and before 9am on monday"
  ],
  "timezone": "Australia/Sydney",
  "enabledManagers": [
    "pep621",
    "pixi",
    "custom.regex",
    "pip_requirements",
    "github-actions",
    "cargo",
    "npm",
    "dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.python-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"python\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"uv\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"pixi\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "prefix-dev/pixi",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"actionlint\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"gitleaks\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^quality\\/tool-versions\\.json$/"],
      "matchStrings": [
        "\"mojo_channel\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "modular/modular",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "pixi",
        "pip_requirements",
        "custom.regex"
      ],
      "groupName": "Python runtime and data stack",
      "dependencyDashboardApproval": true,
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchPackageNames": [
        "hypothesis",
        "mutmut",
        "pytest",
        "pytest-cov",
        "pytest-randomly",
        "pytest-xdist"
      ],
      "groupName": "Test-goblin and pytest toolchain",
      "dependencyDashboardApproval": true,
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "dependencyDashboardApproval": true,
      "separateMinorPatch": true
    },
    {
      "description": "Never adopt prereleases implicitly",
      "matchCurrentVersion": "!/^0/",
      "ignoreUnstable": true
    },
    {
      "description": "Require dashboard approval for major and unstable updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep explicitly experimental dependencies review-gated",
      "matchPackageNames": ["pytest-gremlins", "mojo"],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "dependencyDashboardApproval": true,
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "Node dependencies",
      "dependencyDashboardApproval": true,
      "separateMinorPatch": true
    }
  ]
}
