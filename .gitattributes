* text=auto eol=lf

# Release archives include source, evidence, and static assets. Keep the
# historically problematic inputs explicit as reviewable regression guards.
*.js text eol=lf
*.jsonl text eol=lf
*.sha256 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Reproduce the imported Windows worktree bytes on every CI platform.
vendor/nzmedicines/** text eol=crlf
