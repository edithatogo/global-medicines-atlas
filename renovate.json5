{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    "group:monorepos",
    "group:recommended",
    "schedule:earlyMondays"
  ],
  "labels": ["dependencies", "renovate"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboardAutoclose": true,
  "packageRules": [
    {
      "description": "Keep Python and uv infrastructure together",
      "matchManagers": ["pep621", "uv", "github-actions"],
      "groupName": "Python toolchain"
    },
    {
      "description": "Require explicit review for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pin GitHub Actions to immutable commit SHAs",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
