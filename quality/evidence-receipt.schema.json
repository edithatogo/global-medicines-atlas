{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-medicines-atlas.example/schemas/quality-evidence-receipt-v1.json",
  "title": "Test-Goblin mutation or performance evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_state"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"enum": ["mutation", "performance"]},
    "evidence_state": {"enum": ["contract_only", "measured"]},
    "commit": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string", "format": "date-time"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_state": {"const": "contract_only"}},
        "required": ["evidence_state"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["commit"]},
            {"required": ["generated_at"]},
            {"required": ["observations"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_state": {"const": "measured"}},
        "required": ["evidence_state"]
      },
      "then": {
        "required": [
          "commit",
          "generated_at",
          "command",
          "artifacts",
          "observations"
        ]
      }
    }
  ]
}
