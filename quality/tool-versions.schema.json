{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "versions", "checksums"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionlint", "gitleaks", "mojo_channel", "pixi", "python", "runner", "uv"],
      "properties": {
        "actionlint": {"type": "string"},
        "gitleaks": {"type": "string"},
        "mojo_channel": {"type": "string"},
        "pixi": {"type": "string"},
        "python": {"type": "string"},
        "runner": {"type": "string"},
        "uv": {"type": "string"}
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitleaks_linux_x64"],
      "properties": {
        "gitleaks_linux_x64": {"pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
