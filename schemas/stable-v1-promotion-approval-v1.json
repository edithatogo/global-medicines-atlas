{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/global-medicines-atlas/schemas/stable-v1-promotion-approval-v1.json",
  "title": "Conditional stable v1 promotion approval",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "decision_id",
    "approval_status",
    "approved_by",
    "approved_at",
    "release",
    "conditions",
    "approval_evidence",
    "release_action_performed",
    "excluded_authorities"
  ],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.stable-v1-promotion-approval"},
    "schema_version": {"const": 1},
    "decision_id": {"const": "D-006-11"},
    "approval_status": {"const": "approved_conditional"},
    "approved_by": {"const": "sole_maintainer"},
    "approved_at": {"type": "string", "format": "date"},
    "release": {
      "type": "object",
      "required": ["tag", "release_type", "artifact_scope", "commit_binding"],
      "properties": {
        "tag": {"const": "v1.0.0"},
        "release_type": {"const": "stable"},
        "artifact_scope": {"const": "software-only"},
        "commit_binding": {"const": "tag-must-resolve-to-exact-hosted-workflow-commit"}
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "all_stable_v1_qualification_gates_pass",
          "exact_candidate_artifacts_are_reproduced_and_digest_bound",
          "protected_hosted_checks_and_attestation_verify"
        ]
      },
      "contains": {"const": "all_stable_v1_qualification_gates_pass"},
      "minContains": 1
    },
    "approval_evidence": {
      "type": "object",
      "required": ["source", "maintainer_statement"],
      "properties": {
        "source": {"const": "direct_maintainer_instruction_in_current_conversation"},
        "maintainer_statement": {"const": "Complete Stable v1 approval: it has my approval"}
      },
      "additionalProperties": false
    },
    "release_action_performed": {"const": false},
    "excluded_authorities": {
      "const": [
        "source_rights_or_scope_change",
        "dataset_publication",
        "production_deployment",
        "production_disaster_recovery"
      ]
    }
  },
  "additionalProperties": false
}
