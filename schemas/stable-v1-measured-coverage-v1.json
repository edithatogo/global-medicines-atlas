{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/global-medicines-atlas/schemas/stable-v1-measured-coverage-v1.json",
  "title": "Stable v1 measured jurisdiction and source coverage receipt",
  "type": "object",
  "required": ["body", "receipt_sha256"],
  "properties": {
    "body": {"$ref": "#/$defs/body"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimension": {
      "enum": ["regulatory", "funding", "formulary", "terminology"]
    },
    "maturity": {"enum": ["catalogue", "fixture", "live"]},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["regulatory", "funding", "formulary", "terminology"],
      "properties": {
        "regulatory": {"type": "integer", "minimum": 0},
        "funding": {"type": "integer", "minimum": 0},
        "formulary": {"type": "integer", "minimum": 0},
        "terminology": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "jurisdictions",
        "catalog_dimension",
        "catalog_information_domains",
        "catalog_record_entities",
        "catalog_available_fields",
        "catalogued",
        "fixture_qualified",
        "live_qualified",
        "highest_maturity",
        "measured_fixture_dimensions",
        "catalog_fixture_dimension_agreement",
        "measured_fixture_records",
        "fixture_artifacts",
        "implementation_artifacts",
        "implementations",
        "live_receipt_id",
        "unsupported_claims"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "catalog_dimension": {"$ref": "#/$defs/dimension"},
        "catalog_information_domains": {"$ref": "#/$defs/nonemptyStrings"},
        "catalog_record_entities": {"$ref": "#/$defs/nonemptyStrings"},
        "catalog_available_fields": {"$ref": "#/$defs/nonemptyStrings"},
        "catalogued": {"const": true},
        "fixture_qualified": {"type": "boolean"},
        "live_qualified": {"type": "boolean"},
        "highest_maturity": {"$ref": "#/$defs/maturity"},
        "measured_fixture_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dimension"}
        },
        "catalog_fixture_dimension_agreement": {
          "type": ["boolean", "null"]
        },
        "measured_fixture_records": {"type": "integer", "minimum": 0},
        "fixture_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "implementation_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "implementations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "live_receipt_id": {"type": ["string", "null"]},
        "unsupported_claims": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "object",
      "required": [
        "jurisdiction",
        "catalog_source_count",
        "fixture_source_count",
        "live_source_count",
        "catalog_dimensions",
        "fixture_dimensions",
        "live_dimensions",
        "highest_maturity",
        "regulatory_and_funding_both_catalogued",
        "regulatory_and_funding_both_fixture_qualified"
      ],
      "properties": {
        "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 6},
        "catalog_source_count": {"type": "integer", "minimum": 1},
        "fixture_source_count": {"type": "integer", "minimum": 0},
        "live_source_count": {"type": "integer", "minimum": 0},
        "catalog_dimensions": {"$ref": "#/$defs/counts"},
        "fixture_dimensions": {"$ref": "#/$defs/counts"},
        "live_dimensions": {"$ref": "#/$defs/counts"},
        "highest_maturity": {"$ref": "#/$defs/maturity"},
        "regulatory_and_funding_both_catalogued": {"type": "boolean"},
        "regulatory_and_funding_both_fixture_qualified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": [
        "catalog_jurisdictions",
        "represented_jurisdictions",
        "catalog_sources",
        "fixture_qualified_sources",
        "live_qualified_sources",
        "catalog_dimensions",
        "fixture_dimensions",
        "live_dimensions"
      ],
      "properties": {
        "catalog_jurisdictions": {"type": "integer", "minimum": 1},
        "represented_jurisdictions": {"type": "integer", "minimum": 1},
        "catalog_sources": {"type": "integer", "minimum": 1},
        "fixture_qualified_sources": {"type": "integer", "minimum": 0},
        "live_qualified_sources": {"type": "integer", "minimum": 0},
        "catalog_dimensions": {"$ref": "#/$defs/counts"},
        "fixture_dimensions": {"$ref": "#/$defs/counts"},
        "live_dimensions": {"$ref": "#/$defs/counts"}
      },
      "additionalProperties": false
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "body": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "catalog",
        "catalog_jurisdiction_denominator",
        "qualification_inputs",
        "sources",
        "jurisdictions",
        "totals",
        "evidence_policy",
        "regulatory_funding_separate",
        "unsupported_coverage_fails_closed",
        "external_network_used",
        "external_publication_performed",
        "exhaustive_global_coverage",
        "current_live_coverage_claimed",
        "limitations"
      ],
      "properties": {
        "schema_id": {"const": "global-medicines-atlas.stable-v1-measured-coverage"},
        "schema_version": {"const": 1},
        "catalog": {"$ref": "#/$defs/artifact"},
        "catalog_jurisdiction_denominator": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "qualification_inputs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/jurisdiction"}
        },
        "totals": {"$ref": "#/$defs/totals"},
        "evidence_policy": {
          "const": "catalogue declarations; executable committed fixtures; durable live receipts"
        },
        "regulatory_funding_separate": {"const": true},
        "unsupported_coverage_fails_closed": {"const": true},
        "external_network_used": {"const": false},
        "external_publication_performed": {"const": false},
        "exhaustive_global_coverage": {"const": false},
        "current_live_coverage_claimed": {"const": false},
        "limitations": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    }
  }
}
