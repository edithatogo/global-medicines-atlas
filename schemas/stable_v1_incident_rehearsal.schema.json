{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-medicines-atlas.org/schemas/stable_v1_incident_rehearsal.schema.json",
  "title": "Stable v1 offline incident rehearsal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "evidence_class",
    "compromised_source_id",
    "initial_state",
    "final_state",
    "replacement_evidence",
    "transitions",
    "quarantine_enforced",
    "signing_credential_revocation_rehearsed",
    "dataset_withdrawal_rehearsed",
    "corrected_replacement_prepared",
    "downstream_notification_prepared",
    "downstream_notification_externally_sent",
    "dataset_externally_withdrawn",
    "replacement_externally_published",
    "receipt_sha256",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "incident_id": {"const": "stable-v1-synthetic-compromised-source"},
    "evidence_class": {"const": "synthetic_offline_rehearsal"},
    "compromised_source_id": {"const": "synthetic-compromised-source"},
    "initial_state": {"const": "detected"},
    "final_state": {"const": "notification_prepared"},
    "replacement_evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/evidence"},
      "allOf": [
        {
          "contains": {
            "properties": {"dimension": {"const": "regulatory"}},
            "required": ["dimension"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {"dimension": {"const": "funding"}},
            "required": ["dimension"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "transitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/quarantineTransition"},
        {"$ref": "#/$defs/credentialTransition"},
        {"$ref": "#/$defs/withdrawalTransition"},
        {"$ref": "#/$defs/replacementTransition"},
        {"$ref": "#/$defs/notificationTransition"}
      ],
      "items": false
    },
    "quarantine_enforced": {"const": true},
    "signing_credential_revocation_rehearsed": {"const": true},
    "dataset_withdrawal_rehearsed": {"const": true},
    "corrected_replacement_prepared": {"const": true},
    "downstream_notification_prepared": {"const": true},
    "downstream_notification_externally_sent": {"const": false},
    "dataset_externally_withdrawn": {"const": false},
    "replacement_externally_published": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/digest"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "source_id", "sha256"],
      "properties": {
        "dimension": {"enum": ["regulatory", "funding"]},
        "source_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulated_human_gate",
        "simulated_credential_authority_gate",
        "simulated_publication_gate",
        "external_effect_performed"
      ],
      "properties": {
        "simulated_human_gate": {"type": "boolean"},
        "simulated_credential_authority_gate": {"type": "boolean"},
        "simulated_publication_gate": {"type": "boolean"},
        "external_effect_performed": {"const": false}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "from_state",
        "to_state",
        "gate",
        "previous_sha256",
        "transition_sha256"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "action": {
          "enum": [
            "quarantine_source",
            "revoke_signing_credential",
            "withdraw_dataset",
            "prepare_corrected_replacement",
            "prepare_downstream_notification"
          ]
        },
        "from_state": {
          "enum": [
            "detected",
            "quarantined",
            "credential_revoked",
            "dataset_withdrawn",
            "replacement_prepared"
          ]
        },
        "to_state": {
          "enum": [
            "quarantined",
            "credential_revoked",
            "dataset_withdrawn",
            "replacement_prepared",
            "notification_prepared"
          ]
        },
        "gate": {"$ref": "#/$defs/gate"},
        "previous_sha256": {"$ref": "#/$defs/digest"},
        "transition_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "quarantineTransition": {
      "allOf": [
        {"$ref": "#/$defs/transition"},
        {
          "properties": {
            "sequence": {"const": 1},
            "action": {"const": "quarantine_source"},
            "from_state": {"const": "detected"},
            "to_state": {"const": "quarantined"}
          }
        }
      ]
    },
    "credentialTransition": {
      "allOf": [
        {"$ref": "#/$defs/transition"},
        {
          "properties": {
            "sequence": {"const": 2},
            "action": {"const": "revoke_signing_credential"},
            "from_state": {"const": "quarantined"},
            "to_state": {"const": "credential_revoked"}
          }
        }
      ]
    },
    "withdrawalTransition": {
      "allOf": [
        {"$ref": "#/$defs/transition"},
        {
          "properties": {
            "sequence": {"const": 3},
            "action": {"const": "withdraw_dataset"},
            "from_state": {"const": "credential_revoked"},
            "to_state": {"const": "dataset_withdrawn"}
          }
        }
      ]
    },
    "replacementTransition": {
      "allOf": [
        {"$ref": "#/$defs/transition"},
        {
          "properties": {
            "sequence": {"const": 4},
            "action": {"const": "prepare_corrected_replacement"},
            "from_state": {"const": "dataset_withdrawn"},
            "to_state": {"const": "replacement_prepared"}
          }
        }
      ]
    },
    "notificationTransition": {
      "allOf": [
        {"$ref": "#/$defs/transition"},
        {
          "properties": {
            "sequence": {"const": 5},
            "action": {"const": "prepare_downstream_notification"},
            "from_state": {"const": "replacement_prepared"},
            "to_state": {"const": "notification_prepared"}
          }
        }
      ]
    }
  }
}
