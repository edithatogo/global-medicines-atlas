{
  "$defs": {
    "MbsSilverTableParityReceipt": {
      "additionalProperties": false,
      "description": "Value-free verification result for one MBS Silver table.",
      "properties": {
        "field_count": {
          "exclusiveMinimum": 0,
          "title": "Field Count",
          "type": "integer"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "silver_object_bytes": {
          "exclusiveMinimum": 0,
          "title": "Silver Object Bytes",
          "type": "integer"
        },
        "silver_object_path": {
          "title": "Silver Object Path",
          "type": "string"
        },
        "silver_object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Silver Object Sha256",
          "type": "string"
        },
        "table": {
          "enum": [
            "services",
            "hierarchy",
            "descriptions",
            "fees",
            "benefits",
            "caps"
          ],
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "silver_object_path",
        "silver_object_bytes",
        "silver_object_sha256",
        "row_count",
        "field_count"
      ],
      "title": "MbsSilverTableParityReceipt",
      "type": "object"
    }
  },
