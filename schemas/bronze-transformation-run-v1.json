{
  "$id": "https://global-medicines-atlas.example/schemas/bronze-transformation-run-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_id", "schema_version", "run_id", "acquisition_id",
    "input_content_id", "parser_identity", "transformation_identity",
    "code_commit", "output_schema_version", "environment_identity",
    "environment_sha256", "output", "completed_at"
  ],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.transformation-run"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_content_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parser_identity": {"type": "string", "minLength": 1},
    "transformation_identity": {"type": "string", "minLength": 1},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "output_schema_version": {"type": "string", "minLength": 1},
    "environment_identity": {"type": "string", "minLength": 1},
    "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output": {
      "additionalProperties": false,
      "type": "object",
      "required": ["uri", "sha256", "byte_count"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
