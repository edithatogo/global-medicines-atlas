{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/global-medicines-atlas/schemas/canonical-medicine-v2.json",
  "title": "Canonical medicine structural schema v2",
  "description": "Structural medicine contract, distinct from the temporal assertion migration named v1_to_v2.",
  "type": "object",
  "required": ["schema_id", "schema_version", "record_id", "substances", "products", "packages", "indications", "prices", "restrictions"],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.canonical-medicine"},
    "schema_version": {"const": 2},
    "record_id": {"type": "string", "minLength": 1},
    "substances": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "products": {"type": "array", "items": {"$ref": "#/$defs/product"}},
    "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
    "indications": {"type": "array", "items": {"$ref": "#/$defs/scopedAssertion"}},
    "prices": {"type": "array", "items": {"$ref": "#/$defs/price"}},
    "restrictions": {"type": "array", "items": {"$ref": "#/$defs/scopedAssertion"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "label", "native_identifiers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "native_identifiers": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "product": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "type": "object",
          "required": ["substance_ids", "dose_form", "strength"],
          "properties": {
            "substance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "dose_form": {"type": ["string", "null"]},
            "strength": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "package": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "type": "object",
          "required": ["product_id", "quantity"],
          "properties": {
            "product_id": {"type": "string", "minLength": 1},
            "quantity": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "scopedAssertion": {
      "type": "object",
      "required": ["id", "subject_id", "jurisdiction", "scope", "evidence_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
        "scope": {"type": "string", "minLength": 1},
        "population": {"type": ["string", "null"]},
        "evidence_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "required": ["id", "package_id", "jurisdiction", "amount", "currency", "price_type", "evidence_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "package_id": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
        "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "price_type": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
