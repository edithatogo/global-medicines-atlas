{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/global-medicines-atlas/schemas/comparison-validity-v1.json",
  "title": "Cross-jurisdiction comparison validity v1",
  "type": "object",
  "required": ["schema_id", "schema_version", "left_subject_id", "right_subject_id", "outcome", "dimensions", "material_mismatches", "explanation"],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.comparison-validity"},
    "schema_version": {"const": 1},
    "left_subject_id": {"type": "string", "minLength": 1},
    "right_subject_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["valid", "valid_with_caveats", "inappropriate_comparison", "insufficient_evidence"]},
    "dimensions": {
      "type": "object",
      "required": ["granularity", "indication", "population", "mapping", "normalization"],
      "properties": {
        "granularity": {"$ref": "#/$defs/dimension"},
        "indication": {"$ref": "#/$defs/dimension"},
        "population": {"$ref": "#/$defs/dimension"},
        "mapping": {"$ref": "#/$defs/dimension"},
        "normalization": {"$ref": "#/$defs/dimension"}
      },
      "additionalProperties": false
    },
    "material_mismatches": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "explanation": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "inappropriate_comparison"}}},
      "then": {"properties": {"material_mismatches": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["state", "left_value", "right_value", "evidence_ids"],
      "properties": {
        "state": {"enum": ["aligned", "compatible", "mismatch", "unknown", "not_applicable"]},
        "left_value": {"type": ["string", "null"]},
        "right_value": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
