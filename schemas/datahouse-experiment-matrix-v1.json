{
  "$defs": {
    "ExperimentId": {
      "enum": [
        "iceberg_rest",
        "iceberg_v3",
        "ducklake",
        "object_versioning",
        "batch_attestation",
        "delta_hudi"
      ],
      "title": "ExperimentId",
      "type": "string"
    },
    "ExperimentOutcome": {
      "enum": [
        "supported",
        "unsupported",
        "degraded",
        "failed",
        "not_run_prerequisite_unmet"
      ],
      "title": "ExperimentOutcome",
      "type": "string"
    },
    "ExperimentResult": {
      "additionalProperties": false,
      "description": "One capability-specific result or explicit not-run receipt.",
      "properties": {
        "experiment_id": {
          "$ref": "#/$defs/ExperimentId"
        },
        "unmet_requirement": {
          "minLength": 1,
          "title": "Unmet Requirement",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "thresholds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Thresholds",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ExperimentOutcome"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Prerequisites",
          "type": "array"
        },
        "prerequisites_met": {
          "title": "Prerequisites Met",
          "type": "boolean"
        },
        "specifications": {
          "items": {
            "$ref": "#/$defs/SpecificationReference"
          },
          "minItems": 1,
          "title": "Specifications",
          "type": "array"
        },
        "feature_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Feature Flags",
          "type": "array"
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "rollback_procedure": {
          "minLength": 1,
          "title": "Rollback Procedure",
          "type": "string"
        },
        "rights_review": {
          "minLength": 1,
          "title": "Rights Review",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "promote-candidate",
            "retain-preview",
            "defer",
            "reject"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "optional_for_core": {
          "const": true,
          "default": true,
          "title": "Optional For Core",
          "type": "boolean"
        },
        "production_deployment_claimed": {
          "const": false,
          "default": false,
          "title": "Production Deployment Claimed",
          "type": "boolean"
        },
        "technology_promotion_claimed": {
          "const": false,
          "default": false,
          "title": "Technology Promotion Claimed",
          "type": "boolean"
        }
      },
      "required": [
        "experiment_id",
        "unmet_requirement",
        "hypothesis",
        "baseline",
        "thresholds",
        "outcome",
        "prerequisites",
        "prerequisites_met",
        "specifications",
        "limitations",
        "rollback_procedure",
        "rights_review",
        "disposition"
      ],
      "title": "ExperimentResult",
      "type": "object"
    },
    "SpecificationReference": {
      "additionalProperties": false,
      "description": "An authoritative specification pinned by version or revision.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "SpecificationReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete disposition of all approved datahouse experiments.",
  "properties": {
    "schema_id": {
      "const": "global-medicines-atlas.datahouse-experiment-matrix",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "fixture_path": {
      "pattern": "^tests/fixtures/datahouse/[a-z0-9_.-]+$",
      "title": "Fixture Path",
      "type": "string"
    },
    "fixture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Sha256",
      "type": "string"
    },
    "dependency_lock_path": {
      "const": "uv.lock",
      "title": "Dependency Lock Path",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "python_reference": {
      "const": "3.14",
      "title": "Python Reference",
      "type": "string"
    },
    "bronze_completion_blocking": {
      "const": false,
      "title": "Bronze Completion Blocking",
      "type": "boolean"
    },
    "payload_receipts_remain_authoritative": {
      "const": true,
      "title": "Payload Receipts Remain Authoritative",
      "type": "boolean"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentResult"
      },
      "title": "Experiments",
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "generated_at",
    "fixture_path",
    "fixture_sha256",
    "dependency_lock_path",
    "dependency_lock_sha256",
    "python_reference",
    "bronze_completion_blocking",
    "payload_receipts_remain_authoritative",
    "experiments"
  ],
  "title": "ExperimentMatrix",
  "type": "object"
}
