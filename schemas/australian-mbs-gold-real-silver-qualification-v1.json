          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "source_identity": {
      "type": "object",
      "required": [
        "source_id",
        "schema_era",
        "source_sha256",
