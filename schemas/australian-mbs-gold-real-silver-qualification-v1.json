        "review_state": {
          "const": "not_reviewed"
        },
        "negative_control_outcome": {
          "const": "not_applicable"
        },
        "inferred": {
          "const": false
        },
        "all_edges_same_record_bound": {
          "const": true
        },
        "all_nodes_preserve_native_field_states": {
          "const": true
        },
        "source_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_state": {
          "const": "permitted"
        },
        "source_retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_snapshot_effective_date": {
          "const": "2025-07-01"
        },
