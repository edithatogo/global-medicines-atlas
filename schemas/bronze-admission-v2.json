{
  "$id": "https://global-medicines-atlas.example/schemas/bronze-admission-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_id", "schema_version", "decision_id", "acquisition_id",
    "content_id", "state", "reason_codes", "validation_results",
    "reviewer_status", "actor", "decided_at", "supersedes_decision_id"
  ],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.bronze-admission"},
    "schema_version": {"const": 2},
    "decision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["landed", "accepted", "quarantined", "rejected-from-processing"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_results": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["check_id", "passed", "message"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewer_status": {"enum": ["unreviewed", "approved", "rejected"]},
    "actor": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "supersedes_decision_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
