{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-medicines-atlas.example/schemas/datahouse-experiment-receipt-v1.json",
  "title": "Datahouse experiment receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "outcome", "specification", "runtime", "fixture_sha256", "feature_flags", "limitations", "rollback_procedure"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"enum": ["iceberg_rest", "iceberg_v3", "ducklake", "object_versioning", "batch_attestation", "delta_hudi"]},
    "outcome": {"enum": ["supported", "unsupported", "degraded", "failed", "not_run", "not_run_prerequisite_unmet"]},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "revision"],
      "properties": {
        "uri": {"type": "string", "format": "uri", "pattern": "^https://"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "dependencies"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_procedure": {"type": "string", "minLength": 1}
  }
}
