{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/global-medicines-atlas/schemas/stable-v1-publication-metadata-qualification-v1.json",
  "title": "Stable v1 release-candidate publication metadata qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "qualification_id",
    "result",
    "ready_for_publication",
    "external_actions",
    "inputs",
    "implementation_inputs",
    "package",
    "identities",
    "gates",
    "blockers",
    "receipt_sha256"
  ],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.stable-v1-publication-metadata"},
    "schema_version": {"const": 1},
    "qualification_id": {"const": "stable-v1-release-candidate-publication-metadata"},
    "result": {"const": "metadata_qualified_external_gates_blocked"},
    "ready_for_publication": {"const": false},
    "external_actions": {"$ref": "#/$defs/externalActions"},
    "inputs": {"$ref": "#/$defs/bindings"},
    "implementation_inputs": {"$ref": "#/$defs/bindings"},
    "package": {"$ref": "#/$defs/package"},
    "identities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/identity"}
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/passedDatasetCard"},
        {"$ref": "#/$defs/passedCroissant"},
        {"$ref": "#/$defs/passedChecksums"},
        {"$ref": "#/$defs/passedIdentifierLinks"},
        {"$ref": "#/$defs/passedRestrictedBoundary"},
        {"$ref": "#/$defs/passedExternalIdentifiers"},
        {"$ref": "#/$defs/passedLicences"},
        {"$ref": "#/$defs/blockedPublication"}
      ],
      "items": false
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    },
    "externalActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials_used",
        "publication_performed",
        "release_created",
        "remote_write_attempted",
        "signature_created"
      ],
      "properties": {
        "credentials_used": {"const": false},
        "publication_performed": {"const": false},
        "release_created": {"const": false},
        "remote_write_attempted": {"const": false},
        "signature_created": {"const": false}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "system",
        "object_role",
        "identifier",
        "identifier_state",
        "identifier_evidence",
        "licence_state",
        "licence_expression",
        "licence_decision_evidence",
        "related_object_ids"
      ],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "system": {"enum": ["github", "hugging_face", "zenodo", "osf"]},
        "object_role": {
          "enum": [
            "software_source_release",
            "derived_dataset_distribution",
            "archival_doi_record",
            "protocol_preregistration"
          ]
        },
        "identifier": {"type": ["string", "null"], "minLength": 1},
        "identifier_state": {"enum": ["unresolved", "configured", "verified"]},
        "identifier_evidence": {"type": ["string", "null"], "minLength": 1},
        "licence_state": {"enum": ["unresolved", "approved"]},
        "licence_expression": {"type": ["string", "null"], "minLength": 1},
        "licence_decision_evidence": {"type": ["string", "null"], "minLength": 1},
        "related_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "restricted_data_included",
        "contract_version",
        "dataset_title",
        "dataset_version",
        "contract_sha256",
        "generated_package_sha256",
        "dataset_card_sha256",
        "croissant_sha256",
        "checksums_sha256",
        "manifest_sha256",
        "files"
      ],
      "properties": {
        "fixture_only": {"const": true},
        "restricted_data_included": {"const": false},
        "contract_version": {"type": "string", "minLength": 1},
        "dataset_title": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "generated_package_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_card_sha256": {"$ref": "#/$defs/sha256"},
        "croissant_sha256": {"$ref": "#/$defs/sha256"},
        "checksums_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"$ref": "#/$defs/bindings"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "state", "evidence", "blockers"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["passed", "blocked"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "passedDatasetCard": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "dataset-card"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedCroissant": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "croissant"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedChecksums": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "checksums"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedIdentifierLinks": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "identifier-links"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedRestrictedBoundary": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "restricted-data-boundary"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedExternalIdentifiers": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "external-identifiers"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "passedLicences": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "licences"}, "state": {"const": "passed"}, "blockers": {"maxItems": 0}}
    },
    "blockedPublication": {
      "$ref": "#/$defs/gate",
      "properties": {"gate_id": {"const": "publication"}, "state": {"const": "blocked"}, "blockers": {"minItems": 1}}
    }
  }
}
