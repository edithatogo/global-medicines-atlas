{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-medicines-atlas/schemas/mbs-historical-workbook-source-column-semantics-v1.json",
  "title": "MBS Historical Workbook Source Column Semantics",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "qualification_state",
    "scope",
    "evidence",
    "source_documentation",
    "source_column_meanings",
    "value_and_era_rules",
    "boundaries"
  ],
  "properties": {
    "schema_id": {
      "const": "global-medicines-atlas.mbs-historical-workbook-source-column-semantics"
    },
    "schema_version": { "const": 1 },
    "qualification_state": {
      "enum": ["partial_source_column_meanings_qualified"]
    },
    "scope": {
      "type": "object",
      "required": [
        "dataset",
        "revision",
        "candidate_cohort_receipt",
        "rights_attestation",
        "workbooks",
        "distinct_verified_sheet_header_profiles",
        "normalized_source_column_profiles",
        "interpreted_header_bindings",
        "data_rows_per_field",
        "non_header_values",
        "non_header_value_state"
      ],
      "properties": {
        "dataset": { "const": "edithatogo/australian-mbs-utilisation-archive" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidate_cohort_receipt": { "$ref": "#/$defs/evidenceRef" },
        "rights_attestation": { "$ref": "#/$defs/evidenceRef" },
        "workbooks": { "const": 91 },
        "distinct_verified_sheet_header_profiles": { "const": 91 },
        "normalized_source_column_profiles": { "const": 1 },
        "interpreted_header_bindings": { "const": 728 },
        "data_rows_per_field": { "type": "integer", "minimum": 1 },
        "non_header_values": { "type": "integer", "minimum": 1 },
        "non_header_value_state": { "const": "native_unresolved" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "source_documentation": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["publisher", "uri", "applies_to", "observations", "limitations"],
        "properties": {
          "publisher": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "format": "uri" },
          "repository_copy": { "type": "string", "format": "uri" },
          "applies_to": { "type": "string", "minLength": 1 },
          "observations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "source_column_meanings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["column", "native_header", "field", "state", "meaning", "value_state", "limits"],
        "properties": {
          "column": { "type": "string", "pattern": "^[A-H]$" },
          "native_header": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "state": { "enum": ["interpreted", "interpreted_with_limit"] },
          "meaning": { "type": "string", "minLength": 1 },
          "value_state": { "const": "native_unresolved" },
          "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "value_and_era_rules": {
      "type": "object",
      "required": ["formula_cells", "source_error_cells", "formula_evaluation", "formula_policy", "historical_schema_era", "current_schema_equivalence", "cross_era_pooling", "source_values_emitted", "source_payload_bytes_read"],
      "properties": {
        "formula_cells": { "const": 0 },
        "source_error_cells": { "const": 0 },
        "formula_evaluation": { "const": "not_applicable_for_this_91_workbook_cohort" },
        "formula_policy": { "type": "string", "minLength": 1 },
        "historical_schema_era": { "type": "string", "minLength": 1 },
        "current_schema_equivalence": { "const": false },
        "cross_era_pooling": { "const": false },
        "source_values_emitted": { "const": false },
        "source_payload_bytes_read": { "const": false }
      },
      "additionalProperties": true
    },
    "boundaries": {
      "type": "object",
      "required": ["new_sources", "new_admissions", "consumer_canaries", "publications", "rights_conclusion_changed", "cell_values_promoted", "all_non_header_values_native_unresolved", "m109_complete", "stable_v1_australian_health_federation_accepted"],
      "properties": {
        "new_sources": { "const": 0 },
        "new_admissions": { "const": 0 },
        "consumer_canaries": { "const": 0 },
        "publications": { "const": 0 },
        "rights_conclusion_changed": { "const": false },
        "cell_values_promoted": { "const": 0 },
        "all_non_header_values_native_unresolved": { "const": true },
        "m109_complete": { "const": false },
        "stable_v1_australian_health_federation_accepted": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
