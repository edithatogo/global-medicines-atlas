{
  "$defs": {
    "AccessRestriction": {
      "description": "How the source is accessed; never stores credentials.",
      "enum": [
        "none",
        "unknown",
        "credentialed",
        "licensed_feed",
        "approval_required"
      ],
      "title": "AccessRestriction",
      "type": "string"
    },
    "AcquisitionEvent": {
      "additionalProperties": false,
      "description": "Append-only record of one retrieval; distinct from payload identity.",
      "properties": {
        "acquisition_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "content_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Id",
          "type": "string"
        },
        "evidence_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "retrieval": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "reuse": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReuseGateDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rights_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcquisitionRightsPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rights_reference": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Reference"
        },
        "rights_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/RightsState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_id": {
          "const": "global-medicines-atlas.bronze-acquisition-event",
          "default": "global-medicines-atlas.bronze-acquisition-event",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "default": 3,
          "enum": [
            2,
            3
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityClassification"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_effective_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Effective At"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Published At"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "acquisition_id",
        "content_id",
        "source_id",
        "retrieved_at",
        "payload_sha256"
      ],
      "title": "AcquisitionEvent",
      "type": "object"
    },
    "AcquisitionMethod": {
      "description": "How source bytes or records were acquired.",
      "enum": [
        "api",
        "download",
        "licensed_feed",
        "manual_export",
        "web_query",
        "local_fixture"
      ],
      "title": "AcquisitionMethod",
      "type": "string"
    },
    "AcquisitionRightsPolicy": {
      "additionalProperties": false,
      "description": "Rights record bound to one acquisition identity.",
      "properties": {
        "access_restriction": {
          "$ref": "#/$defs/AccessRestriction"
        },
        "acquisition_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "attribution_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Requirement"
        },
        "licence_evidence_uri": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence Evidence Uri"
        },
        "licence_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence Expression"
        },
        "maintainer_licence_approved": {
          "default": false,
          "title": "Maintainer Licence Approved",
          "type": "boolean"
        },
        "maintainer_publication_approved": {
          "default": false,
          "title": "Maintainer Publication Approved",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "publish_bytes": {
          "$ref": "#/$defs/Permission"
        },
        "redistribute": {
          "$ref": "#/$defs/Permission"
        },
        "retain_evidence": {
          "$ref": "#/$defs/Permission"
        },
        "review_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Expires At"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "schema_id": {
          "const": "global-medicines-atlas.acquisition-rights-policy",
          "default": "global-medicines-atlas.acquisition-rights-policy",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Permission"
        }
      },
      "required": [
        "acquisition_id",
        "source_id",
        "retain_evidence",
        "publish_bytes",
        "redistribute",
        "transform",
        "access_restriction",
        "review_status",
        "observed_at"
      ],
      "title": "AcquisitionRightsPolicy",
      "type": "object"
    },
    "AcquisitionStatus": {
      "description": "Observable outcome of a retrieval attempt.",
      "enum": [
        "succeeded",
        "failed",
        "unavailable"
      ],
      "title": "AcquisitionStatus",
      "type": "string"
    },
    "DataSensitivity": {
      "description": "Intrinsic disclosure risk, independent from licensing permission.",
      "enum": [
        "unknown",
        "non_sensitive",
        "sensitive",
        "restricted"
      ],
      "title": "DataSensitivity",
      "type": "string"
    },
    "DiscoverySurface": {
      "additionalProperties": false,
      "description": "Pinned result for one discovery surface.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReuseCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "name": {
          "enum": [
            "local_clones",
            "github",
            "hugging_face",
            "source_registry"
          ],
          "title": "Name",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/DiscoverySurfaceState"
        }
      },
      "required": [
        "name",
        "state",
        "query"
      ],
      "title": "DiscoverySurface",
      "type": "object"
    },
    "DiscoverySurfaceState": {
      "description": "Outcome of one required discovery surface.",
      "enum": [
        "success",
        "unavailable",
        "incomplete"
      ],
      "title": "DiscoverySurfaceState",
      "type": "string"
    },
    "EvidenceClass": {
      "description": "Qualification class, kept distinct from acquisition success.",
      "enum": [
        "fixture",
        "synthetic",
        "dry_run",
        "live",
        "historical",
        "unavailable"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "HttpRetrievalEvidence": {
      "additionalProperties": false,
      "description": "Evidence-grade HTTP/API retrieval metadata without secrets.",
      "properties": {
        "acquisition_agent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Agent Version"
        },
        "content_encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Encoding"
        },
        "content_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Length"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "final_uri": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Uri"
        },
        "http_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Method"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "last_modified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified"
        },
        "observed_byte_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Byte Length"
        },
        "original_uri": {
          "format": "uri",
          "minLength": 1,
          "title": "Original Uri",
          "type": "string"
        },
        "redirect_history": {
          "default": [],
          "items": {
            "format": "uri",
            "minLength": 1,
            "type": "string"
          },
          "title": "Redirect History",
          "type": "array"
        },
        "source_native_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Native Date"
        },
        "source_native_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Native Version"
        }
      },
      "required": [
        "original_uri"
      ],
      "title": "HttpRetrievalEvidence",
      "type": "object"
    },
    "Permission": {
      "description": "Explicit permission; unknown is not an implied grant.",
      "enum": [
        "unknown",
        "permitted",
        "conditional",
        "prohibited"
      ],
      "title": "Permission",
      "type": "string"
    },
    "PersonalDataState": {
      "description": "Observed or plausible personal-data content in source bytes.",
      "enum": [
        "unknown",
        "none",
        "possible",
        "present"
      ],
      "title": "PersonalDataState",
      "type": "string"
    },
    "PublicationDisposition": {
      "description": "Publication decision, evaluated separately from source rights.",
      "enum": [
        "review_required",
        "permitted",
        "prohibited"
      ],
      "title": "PublicationDisposition",
      "type": "string"
    },
    "RawEvidenceKind": {
      "description": "The source-native object represented by a B2 row.",
      "enum": [
        "source_payload",
        "source_archive",
        "source_document"
      ],
      "title": "RawEvidenceKind",
      "type": "string"
    },
    "RawEvidenceManifest": {
      "additionalProperties": false,
      "description": "Deterministic, rebuildable inventory of B2 rows.",
      "properties": {
        "authoritative": {
          "const": true,
          "default": true,
          "title": "Authoritative",
          "type": "boolean"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/RawEvidenceRecord"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "schema_id": {
          "const": "global-medicines-atlas.b2-raw-evidence-manifest",
          "default": "global-medicines-atlas.b2-raw-evidence-manifest",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "row_count",
        "manifest_sha256",
        "rows"
      ],
      "title": "RawEvidenceManifest",
      "type": "object"
    },
    "RawEvidenceRecord": {
      "additionalProperties": false,
      "description": "One B2 object/reference linked to one immutable acquisition.",
      "properties": {
        "acquisition_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocked Reason"
        },
        "byte_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Count"
        },
        "content_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Id",
          "type": "string"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "kind": {
          "$ref": "#/$defs/RawEvidenceKind",
          "default": "source_payload"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "payload_contents_in_metadata": {
          "const": false,
          "default": false,
          "title": "Payload Contents In Metadata",
          "type": "boolean"
        },
        "payload_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Sha256"
        },
        "raw_object_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Object Locator"
        },
        "schema_id": {
          "const": "global-medicines-atlas.b2-raw-evidence",
          "default": "global-medicines-atlas.b2-raw-evidence",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_native_bytes_immutable": {
          "const": true,
          "default": true,
          "title": "Source Native Bytes Immutable",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/RawEvidenceState"
        },
        "stratum": {
          "const": "B2",
          "default": "B2",
          "title": "Stratum",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "acquisition_id",
        "content_id",
        "state"
      ],
      "title": "RawEvidenceRecord",
      "type": "object"
    },
    "RawEvidenceState": {
      "description": "Whether B2 retains bytes or records a bounded absence.",
      "enum": [
        "retained",
        "external_reference_only",
        "blocked"
      ],
      "title": "RawEvidenceState",
      "type": "string"
    },
    "RetrievalEvidence": {
      "additionalProperties": false,
      "description": "The access surface, clock, method, and outcome of one attempt.",
      "properties": {
        "acquisition_method": {
          "$ref": "#/$defs/AcquisitionMethod"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpRetrievalEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AcquisitionStatus"
        },
        "uri": {
          "format": "uri",
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "retrieved_at",
        "acquisition_method",
        "status"
      ],
      "title": "RetrievalEvidence",
      "type": "object"
    },
    "ReuseCandidate": {
      "additionalProperties": false,
      "description": "One hit from a required search surface.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "$ref": "#/$defs/ReuseCandidateKind"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "surface": {
          "enum": [
            "local_clones",
            "github",
            "hugging_face",
            "source_registry"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "locator",
        "source_id",
        "kind"
      ],
      "title": "ReuseCandidate",
      "type": "object"
    },
    "ReuseCandidateKind": {
      "description": "What a search hit actually found.",
      "enum": [
        "payload",
        "registry",
        "schema",
        "related"
      ],
      "title": "ReuseCandidateKind",
      "type": "string"
    },
    "ReuseDiscoverySnapshot": {
      "additionalProperties": false,
      "description": "Content-addressed, freshness-bounded search observation.",
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "freshness_seconds": {
          "exclusiveMinimum": 0,
          "title": "Freshness Seconds",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "schema_id": {
          "const": "global-medicines-atlas.reuse-discovery",
          "default": "global-medicines-atlas.reuse-discovery",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "default": "",
          "pattern": "^sha256:[0-9a-f]{64}$|^",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "surfaces": {
          "default": [],
          "items": {
