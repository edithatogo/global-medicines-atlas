{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-medicines-atlas.org/schemas/stable_v1_aggregate_rehearsal.schema.json",
  "title": "Stable v1 representative aggregate rehearsal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "evidence_class",
    "input_sha256",
    "fixture_sha256",
    "qualification_input_tree_sha256",
    "clean_room",
    "canonical",
    "recovery",
    "passed",
    "production_disaster_recovery_qualified",
    "external_publication_verified",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_id": {"const": "global-medicines-atlas.stable-v1-rehearsal"},
    "schema_version": {"const": 2},
    "evidence_class": {"const": "deterministic_representative_fixtures"},
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas/canonical-medicine-v2.json",
        "schemas/stable-v1-rehearsal-v1.json",
        "schemas/stable_v1_aggregate_rehearsal.schema.json",
        "scripts/rehearse_stable_v1.py",
        "src/global_medicines_atlas/canonical_v2.py",
        "src/global_medicines_atlas/models.py",
        "src/global_medicines_atlas/recovery.py",
        "src/global_medicines_atlas/recovery_rehearsal.py",
        "src/global_medicines_atlas/stable_v1_rehearsal.py",
        "uv.lock"
      ],
      "properties": {
        "schemas/canonical-medicine-v2.json": {"$ref": "#/$defs/digest"},
        "schemas/stable-v1-rehearsal-v1.json": {"$ref": "#/$defs/digest"},
        "schemas/stable_v1_aggregate_rehearsal.schema.json": {"$ref": "#/$defs/digest"},
        "scripts/rehearse_stable_v1.py": {"$ref": "#/$defs/digest"},
        "src/global_medicines_atlas/canonical_v2.py": {"$ref": "#/$defs/digest"},
        "src/global_medicines_atlas/models.py": {"$ref": "#/$defs/digest"},
        "src/global_medicines_atlas/recovery.py": {"$ref": "#/$defs/digest"},
        "src/global_medicines_atlas/recovery_rehearsal.py": {"$ref": "#/$defs/digest"},
        "src/global_medicines_atlas/stable_v1_rehearsal.py": {"$ref": "#/$defs/digest"},
        "uv.lock": {"$ref": "#/$defs/digest"}
      }
    },
    "fixture_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_v1_fixture",
        "structural_projection_fixture"
      ],
      "properties": {
        "canonical_v1_fixture": {"$ref": "#/$defs/digest"},
        "structural_projection_fixture": {"$ref": "#/$defs/digest"}
      }
    },
    "qualification_input_tree_sha256": {"$ref": "#/$defs/digest"},
    "clean_room": {"$ref": "#/$defs/cleanRoom"},
    "canonical": {"$ref": "#/$defs/canonical"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "passed": {"const": true},
    "production_disaster_recovery_qualified": {"const": false},
    "external_publication_verified": {"const": false},
    "limitations": {"$ref": "#/$defs/limitations"},
    "content_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cleanRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "canonical_v1_sha256",
        "canonical_v2_sha256",
        "identity_reproduced",
        "current_checkout_used",
        "artifact_only_release_reproduction",
        "external_network_isolation_verified"
      ],
      "properties": {
        "boundary": {"const": "independent_local_fixture_process"},
        "canonical_v1_sha256": {"$ref": "#/$defs/digest"},
        "canonical_v2_sha256": {"$ref": "#/$defs/digest"},
        "identity_reproduced": {"const": true},
        "current_checkout_used": {"const": true},
        "artifact_only_release_reproduction": {"const": false},
        "external_network_isolation_verified": {"const": false}
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_v1_sha256",
        "canonical_v2_sha256",
        "rolled_back_v1_sha256",
        "migration_deterministic",
        "rollback_exact",
        "regulatory_funding_separation_verified"
      ],
      "properties": {
        "canonical_v1_sha256": {"$ref": "#/$defs/digest"},
        "canonical_v2_sha256": {"$ref": "#/$defs/digest"},
        "rolled_back_v1_sha256": {"$ref": "#/$defs/digest"},
        "migration_deterministic": {"const": true},
        "rollback_exact": {"const": true},
        "regulatory_funding_separation_verified": {"const": true}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_class",
        "backup_receipt_id",
        "original_tree_sha256",
        "predecessor_tree_sha256",
        "restored_tree_sha256",
        "rolled_back_tree_sha256",
        "backup_verified",
        "restore_verified",
        "rollback_verified",
        "failed_restore_quarantined",
        "production_disaster_recovery_qualified",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "evidence_class": {"const": "synthetic_local_artifacts"},
        "backup_receipt_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "original_tree_sha256": {"$ref": "#/$defs/digest"},
        "predecessor_tree_sha256": {"$ref": "#/$defs/digest"},
        "restored_tree_sha256": {"$ref": "#/$defs/digest"},
        "rolled_back_tree_sha256": {"$ref": "#/$defs/digest"},
        "backup_verified": {"const": true},
        "restore_verified": {"const": true},
        "rollback_verified": {"const": true},
        "failed_restore_quarantined": {"const": true},
        "production_disaster_recovery_qualified": {"const": false},
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    }
  }
}
