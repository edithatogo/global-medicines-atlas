      "additionalProperties": false,
      "properties": {
        "granularity": {
          "$ref": "#/components/schemas/ComparisonValidityDimension"
        },
        "indication": {
          "$ref": "#/components/schemas/ComparisonValidityDimension"
        },
        "mapping": {
          "$ref": "#/components/schemas/ComparisonValidityDimension"
        },
        "normalization": {
          "$ref": "#/components/schemas/ComparisonValidityDimension"
        },
        "population": {
          "$ref": "#/components/schemas/ComparisonValidityDimension"
        }
      },
      "required": [
        "granularity",
        "indication",
        "population",
        "mapping",
        "normalization"
      ],
      "type": "object"
    },
