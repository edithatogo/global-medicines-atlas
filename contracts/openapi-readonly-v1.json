        },
        "metadata": {
          "$ref": "#/components/schemas/ResponseMetadata"
        },
        "validity": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/ComparisonValidity"
          },
          "title": "Validity",
          "type": "array"
        }
      },
      "required": [
        "metadata",
        "conclusions"
      ],
      "type": "object"
    },
    "ComparisonValidity": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "$ref": "#/components/schemas/ComparisonValidityDimensions"
        },
