        "status_code": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        },
        "terminology": {
          "$ref": "#/components/schemas/Terminology"
        },
        "uncertainty": {
          "$ref": "#/components/schemas/Uncertainty"
        },
        "valid_time": {
          "$ref": "#/components/schemas/AsOfClocks"
        }
