        "schema_id": {
          "const": "global-medicines-atlas.comparison-validity",
          "default": "global-medicines-atlas.comparison-validity",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "left_subject_id",
        "right_subject_id",
        "outcome",
        "dimensions",
        "explanation"
      ],
      "type": "object"
    },
    "ComparisonValidityDimension": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "default": [],
