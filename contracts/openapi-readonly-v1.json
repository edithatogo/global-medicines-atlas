      "enum": [
        "exact_concept_id",
        "exact_identifier",
        "normalized_preferred_name",
        "normalized_alias"
      ],
      "type": "string"
    },
    "PageMetadata": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 250.0,
          "minimum": 1.0,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "returned": {
          "maximum": 250.0,
          "minimum": 0.0,
          "title": "Returned",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "returned"
