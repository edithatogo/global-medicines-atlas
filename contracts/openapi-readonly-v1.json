      "enum": [
        "ok",
        "degraded",
        "unavailable"
      ],
      "type": "string"
    },
    "JurisdictionSummary": {
      "additionalProperties": false,
      "properties": {
        "concept_count": {
          "minimum": 0.0,
          "title": "Concept Count",
          "type": "integer"
        },
        "jurisdiction": {
          "pattern": "^[A-Z]{2,3}$",
          "title": "Jurisdiction",
          "type": "string"
        },
        "source_count": {
          "minimum": 0.0,
          "title": "Source Count",
          "type": "integer"
        }
      },
      "required": [
        "jurisdiction",
        "source_count",
        "concept_count"
      ],
      "type": "object"
    },
    "MatchExplanation": {
      "additionalProperties": false,
      "properties": {
        "establishes_equivalence": {
          "const": false,
          "default": false,
          "title": "Establishes Equivalence",
          "type": "boolean"
        },
        "matched_value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Matched Value",
          "type": "string"
        },
        "method": {
          "$ref": "#/components/schemas/MatchMethod"
        },
        "normalized_query": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Normalized Query",
          "type": "string"
        }
      },
      "required": [
        "method",
        "matched_value",
        "normalized_query"
      ],
      "type": "object"
    },
