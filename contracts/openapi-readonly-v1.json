        },
        "metadata": {
          "$ref": "#/components/schemas/ResponseMetadata"
        }
      },
      "required": [
        "metadata",
        "evidence"
      ],
      "type": "object"
    },
    "HealthCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "state": {
          "$ref": "#/components/schemas/HealthState"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "v1",
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "checks": {
          "default": [],
