        },
        "dimension": {
          "$ref": "#/components/schemas/EvidenceDimension"
        },
        "jurisdiction": {
          "pattern": "^[A-Z]{2,3}$",
          "title": "Jurisdiction",
          "type": "string"
        },
        "provenance": {
          "default": [],
