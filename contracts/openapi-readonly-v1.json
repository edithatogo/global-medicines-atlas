          "const": false,
          "default": false,
          "title": "Establishes Equal Benefit",
          "type": "boolean"
        },
        "establishes_medicine_equivalence": {
          "const": false,
          "default": false,
          "title": "Establishes Medicine Equivalence",
          "type": "boolean"
        },
        "establishes_substitutability": {
          "const": false,
          "default": false,
          "title": "Establishes Substitutability",
          "type": "boolean"
        },
        "establishes_therapeutic_interchangeability": {
          "const": false,
          "default": false,
          "title": "Establishes Therapeutic Interchangeability",
          "type": "boolean"
        },
        "explanation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "left_subject_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Left Subject Id",
          "type": "string"
        },
        "material_mismatches": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Mismatches",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/components/schemas/ComparisonValidityOutcome"
        },
        "right_subject_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Right Subject Id",
          "type": "string"
