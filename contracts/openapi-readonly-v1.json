            {
              "type": "null"
            }
          ],
          "title": "Left Value"
        },
        "right_value": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right Value"
        },
        "state": {
          "$ref": "#/components/schemas/ComparisonDimensionState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
